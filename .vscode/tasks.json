{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EGFR: check configuration",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "egfr_lab", "check-config"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
      "problemMatcher": []
    },
    {
      "label": "EGFR: run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    }
  ]
}
